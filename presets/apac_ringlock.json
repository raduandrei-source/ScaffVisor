 "_meta": {
  "id": "apac_ringlock",
  "name": "APAC Ringlock (steel, 73 cm)",
  "family": "Ringlock 0.73 m, grid 1.57-3.07 m (Layher Allround type, node 0.50 m)",
  "status": "draft",
  "note": "Facade scaffold from the APAC Scaffold & Formwork catalogue (Suzhou): 0.73 m ledgers as transoms, 2 x 0.32 m access steel planks per bay, ledgers as guard rails, diagonals for a 2.0 m lift. The catalogue has no article numbers: codes are descriptive. Values are catalog values; 'verified' = false until weighed/measured.",
  "units": {
   "length": "mm",
   "mass": "kg"
  },
  "sources": [
   "168261806-APAC-Scaffold-Formwork-Catalogue.pdf PDF p.15 (standards, base collar), p.16 (ledgers, U-ledger deck table, base jack), p.17 (diagonal braces), p.19 (steel planks), p.20 (access deck with ladder), p.9 (wall tie, Kwikstage section), p.36 (couplers)."
  ],
  "approvals": [
   "ISO 9001 (factory)"
  ],
  "changes": [
   "Initial draft from scratchpad/out/asia_uk.json (APAC Ringlock), values re-checked on PDF p.16, 17, 19, 20, 9.",
   "No article numbers in the catalogue: descriptive codes STD-/LDG-/SP32-/DB-/ADL-.",
   "Standards 'with spigot' series. Transom = 0.73 m ledger (tube) carrying 2 x 0.32 m planks (U-ledger deck table p.16: 0.73 -> 2 x 0.32).",
   "Bays 1.57/2.07/2.57/3.07 m; extras 0.73/1.09/1.40 m.",
   "Toe boards are mentioned ('can be attached', p.15) but not listed: toe boards estimated with toeboard_est_kg_per_m = 2.0 (end toe board 0.73 m estimated 1.5 kg).",
   "Base jack: 3.7 kg, length and travel not given -> length 600 mm estimated, jack_ext_max_ratio 0.68 (default).",
   "Ties: 0.6 m Wall Tie (S-hook tube, 2.24 kg) from the Kwikstage section p.9 of the same catalogue; coupler = drop-forged double coupler 0.98 kg (p.36); eyebolt estimated 0.2 kg.",
   "Diagonal 1.09 m x 2.0 m is printed 7.1 kg (lighter than the 1.04 m one, 7.7 kg): kept as printed.",
   "Brace l_mm = geometric axis length; the catalogue gives bay x height only.",
   "Load class and width class not published: max_load_class 3 / 2.0 kN/m2 are defaults."
  ]
 },
