 "_meta": {
  "id": "coronet_ringlock",
  "name": "Coronet Ringlock (steel, 73 cm)",
  "family": "Ringlock 0.73 m, grid 1.57-3.07 m (Layher Allround type, node 0.50 m)",
  "status": "draft",
  "note": "Facade scaffold built from the Coronet Ringlock 2023 catalog (UK/AU/NZ edition): O-ledgers 0.73 m as transoms, 2 x O-steel planks 320 per bay, O-ledgers as guard rails, RDB diagonals for a 2.0 m lift. Values are catalog values; 'verified' = false until weighed/measured.",
  "units": {
   "length": "mm",
   "mass": "kg"
  },
  "sources": [
   "681927970-coronet-scaffold-ringlock-system-2023.pdf PDF p.7 (standards), p.8 (O-ledgers), p.16 (diagonals), p.17 (O-steel planks 320), p.21-22 (access decks), p.25 (steel toe boards), p.28 (base collar), p.29 (base jack), p.47 (right angle clamp). Printed page = PDF page - 1."
  ],
  "approvals": [],
  "changes": [
   "Initial draft from scratchpad/out/modular.json (Coronet object), values re-checked on PDF p.7, 16, 25, 28, 29, 47.",
   "Transom = O-Ledger RH073 (O-planks hook on the 48.3 tube); the U-system (RHU073 + RWP planks) is the alternative and is not modelled.",
   "Bays 1.57/2.07/2.57/3.07 m; short bays 0.73/1.09/1.40 m as extras (all have ledger, plank, toe board and diagonal).",
   "Guard rails = the same O-ledgers (2 per bay and level); open end = 2 x RH073 + toe board RSTB073.",
   "Base jack CSJB 0.6 m: travel not published -> jack_ext_max_ratio 0.68 (default) gives 0.41 m.",
   "Ties: the catalog has no tie tube and no eyebolt. Tie tube estimated (1.0 m of 48.3 x 3.2 tube = 3.55 kg/m, value from the PERI catalog), eyebolt estimated 0.2 kg; coupler = Right Angle Clamp RCA (1.00 kg printed; the lb column says 3.30 lb = 1.50 kg).",
   "Brace l_mm = geometric axis length sqrt(bay^2 + 2000^2); the catalog gives only bay x lift.",
   "Load class and width class are not published: max_load_class 3 / 2.0 kN/m2 are defaults; W06 derived from 2 x 320 mm planks.",
   "RV10 mass 5.21 kg kept as printed (lb column 12.10 lb = 5.49 kg disagrees; 5.21 fits between RV05 and RV15)."
  ]
 },
